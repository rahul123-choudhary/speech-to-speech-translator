# Firebase service-account JSON is read only on the server.
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=quechua_s2st

# Models and runtime
ENCODER_MODEL=facebook/wav2vec2-xls-r-300m
ASR_MODEL=openai/whisper-small
DEVICE=cuda
MAX_UTTERANCE_SECONDS=15

# One independently trained direct model per output language.
S2ST_CHECKPOINT_ES=./artifacts/que_spa_2h/best.pt
S2ST_CHECKPOINT_EN=./artifacts/que_eng_2h/best.pt
S2ST_CHECKPOINT_HI=./artifacts/que_hin_2h/best.pt
S2ST_CHECKPOINT_FR=./artifacts/que_fra_2h/best.pt
S2ST_CHECKPOINT_PT=./artifacts/que_por_2h/best.pt
