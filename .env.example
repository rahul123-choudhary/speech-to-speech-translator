# Firebase service-account JSON is read only on the server.
# Keep the private JSON outside synced folders and point this to its local path.
FIREBASE_CREDENTIALS_PATH=C:/path/outside/project/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_MEASUREMENT_ID=G-EXAMPLE
ALLOW_DEVELOPMENT_AUTH=false
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=yoruba_s2st

# Models and runtime
ENCODER_MODEL=facebook/wav2vec2-xls-r-300m
ASR_MODEL=openai/whisper-small
DEVICE=cpu
MAX_UTTERANCE_SECONDS=15
# Optional checkpoints. Configure these only after training on real, consented,
# reviewed Yorùbá–English data.
# S2ST_CHECKPOINT_EN=./artifacts/yoruba_en/best.pt
